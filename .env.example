# Valvix Environment Configuration
# PostgreSQL (Docker default)
DATABASE_URL=postgresql+asyncpg://valvix_user:valvix_password@localhost:5432/valvix_db
# Offline fallback for rapid testing without active Docker daemon:
# DATABASE_URL=sqlite+aiosqlite:///./valvix.db

# Steam Web API Key (Get yours at https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_web_api_key_here

# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Frontend API Endpoint (used in frontend/.env or Vercel)
VITE_API_BASE_URL=http://localhost:8000/api
